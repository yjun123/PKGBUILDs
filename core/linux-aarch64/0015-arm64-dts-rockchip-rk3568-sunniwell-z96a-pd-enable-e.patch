From 2b652c92cbddca5fc5b2378236cf61e1cbed42bb Mon Sep 17 00:00:00 2001
From: Jun Yan <jerrysteve1101@gmail.com>
Date: Sat, 10 Oct 2026 00:10:32 +0800
Subject: [PATCH 15/22] arm64: dts: rockchip: rk3568-sunniwell-z96a-pd: enable
 eDP display

Enable the internal BOE NV140FHD-N43 eDP panel on the RK3568 eDP
controller (driven by the analogix_dp and Naneng eDP PHY), wired to
VOP2 vp1.

Signed-off-by: Jun Yan <jerrysteve1101@gmail.com>
---
 .../dts/rockchip/rk3568-sunniwell-z96a-pd.dts | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-pd.dts b/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-pd.dts
index 314e7d69f408..c65330c884ab 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-pd.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-pd.dts
@@ -83,6 +83,25 @@ led_work: led-0 {
 		};
 	};
 
+	/*
+	 * Internal 1920x1080@60 eDP panel on the RK3568 eDP controller
+	 * (@ fe0c0000), driven by the analogix_dp + Naneng eDP PHY. The
+	 * panel node below is wired to the eDP controller in the &edp
+	 * override further down. HDMI stays on vp0, eDP on vp1.
+	 */
+	panel: panel {
+		compatible = "boe,nv140fhd-n43";
+		backlight = <&backlight>;
+		power-supply = <&vcc3v3_lcd0_n>;
+		no-hpd;
+
+		port {
+			panel_in_edp: endpoint {
+				remote-endpoint = <&edp_out_panel>;
+			};
+		};
+	};
+
 	rk809-sound {
 		compatible = "simple-audio-card";
 		pinctrl-names = "default";
@@ -917,6 +936,34 @@ vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
 	};
 };
 
+&vp1 {
+	vp1_out_edp: endpoint@ROCKCHIP_VOP2_EP_EDP0 {
+		reg = <ROCKCHIP_VOP2_EP_EDP0>;
+		remote-endpoint = <&edp_in_vp1>;
+	};
+};
+
+&edp_phy {
+	status = "okay";
+};
+
+&edp {
+	force-hpd;
+	status = "okay";
+};
+
+&edp_in {
+	edp_in_vp1: endpoint {
+		remote-endpoint = <&vp1_out_edp>;
+	};
+};
+
+&edp_out {
+	edp_out_panel: endpoint {
+		remote-endpoint = <&panel_in_edp>;
+	};
+};
+
 /*
  * The RT1711H INT line (GPIO0_C5) is left as an output by the bootloader,
  * which makes gpiochip_lock_as_irq() refuse to use it as an interrupt source
-- 
2.56.0

