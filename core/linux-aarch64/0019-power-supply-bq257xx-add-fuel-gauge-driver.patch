From d8ae4faf5f7f5af1b8e6d90ecba0e929e4d611ba Mon Sep 17 00:00:00 2001
From: Jun Yan <jerrysteve1101@gmail.com>
Date: Thu, 8 Oct 2026 23:00:51 +0800
Subject: [PATCH 19/22] power: supply: bq257xx: add fuel gauge driver

The BQ25703A (and the register-compatible SC8886S) integrates an ADC
that can measure the battery voltage and current. Register a fuel gauge
power supply that converts the voltage to a state of charge using the
OCV table of the monitored battery, compensating the IR-drop across the
internal resistance when it is known.

Add the fuel gauge as a third MFD cell of the bq257xx device so that it
shares the parent regmap, following the same pattern as the charger and
regulator cells.
---
 drivers/mfd/bq257xx.c                     |   1 +
 drivers/power/supply/Kconfig              |  11 ++
 drivers/power/supply/Makefile             |   1 +
 drivers/power/supply/bq257xx_fuel_gauge.c | 214 ++++++++++++++++++++++
 4 files changed, 227 insertions(+)
 create mode 100644 drivers/power/supply/bq257xx_fuel_gauge.c

diff --git a/drivers/mfd/bq257xx.c b/drivers/mfd/bq257xx.c
index 8839a4d4ea23..0026b7e514be 100644
--- a/drivers/mfd/bq257xx.c
+++ b/drivers/mfd/bq257xx.c
@@ -75,6 +75,7 @@ static const struct regmap_config bq25792_regmap_config = {
 static const struct mfd_cell cells[] = {
 	MFD_CELL_NAME("bq257xx-regulator"),
 	MFD_CELL_NAME("bq257xx-charger"),
+	MFD_CELL_NAME("bq257xx-fgu"),
 };
 
 static int bq257xx_probe(struct i2c_client *client)
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index f0ede1cecb6a..8da447ba44ea 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -822,6 +822,17 @@ config CHARGER_BQ257XX
 	  Say Y to enable support for the TI BQ257XX family of battery
 	  charging integrated circuits.
 
+config FUEL_GAUGE_BQ257XX
+	tristate "TI BQ257XX battery fuel gauge"
+	depends on MFD_BQ257XX
+	help
+	  Say Y to enable support for the battery fuel gauge in the TI
+	  BQ257XX family of charging integrated circuits.
+
+	  This driver measures the battery voltage and current through the
+	  integrated ADC and reports the state of charge using the OCV
+	  table of the monitored battery.
+
 config CHARGER_BQ25890
 	tristate "TI BQ25890 battery charger driver"
 	depends on I2C
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
index 31fe4a145929..9cdd47ca27a4 100644
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -103,6 +103,7 @@ obj-$(CONFIG_CHARGER_BQ24257)	+= bq24257_charger.o
 obj-$(CONFIG_CHARGER_BQ24735)	+= bq24735-charger.o
 obj-$(CONFIG_CHARGER_BQ2515X)	+= bq2515x_charger.o
 obj-$(CONFIG_CHARGER_BQ257XX)	+= bq257xx_charger.o
+obj-$(CONFIG_FUEL_GAUGE_BQ257XX)	+= bq257xx_fuel_gauge.o
 obj-$(CONFIG_CHARGER_BQ25890)	+= bq25890_charger.o
